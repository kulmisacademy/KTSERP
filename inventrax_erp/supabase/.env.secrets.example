# Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets)
# Or: supabase secrets set --env-file supabase/.env.secrets

# Resend — https://resend.com (verify domain e.g. mail.kulmiserp.com)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=noreply@kulmiserp.com
RESEND_FROM_NAME=KULMIS ERP

# Optional pepper for OTP hashing (set a long random string in production)
EMAIL_OTP_PEPPER=change-me-in-production

# Dev: returns OTP 123456 without sending email
OTP_DEV_MODE=false

# Waafi Pay — https://docs.waafipay.com/
WAAFI_MERCHANT_UID=your_merchant_uid
WAAFI_API_USER_ID=your_api_user_id
WAAFI_API_KEY=your_api_key
WAAFI_SANDBOX=true
WAAFI_DEV_MODE=true
PAYMENT_WEBHOOK_SECRET=your_webhook_secret
